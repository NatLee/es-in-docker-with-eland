# Reviewed 2026-10-23. Keep Elasticsearch and Kibana on the same exact version.
STACK_VERSION=9.5.5
COMPOSE_PROJECT_NAME=eland-tutorial-v9
CLUSTER_NAME=eland-tutorial

# Host ports are bound to 127.0.0.1 by docker-compose.yml.
ES_PORT=9200
KIBANA_PORT=5601
ES_MEM_LIMIT=2g
KIBANA_MEM_LIMIT=1g

# Generate these values with: python3 scripts/init_env.py
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
KIBANA_SECURITY_KEY=
KIBANA_SAVED_OBJECTS_KEY=
KIBANA_REPORTING_KEY=

# Python clients derive their HTTPS URL from ES_PORT unless overridden.
ELASTIC_USERNAME=elastic
ELASTIC_CA_CERT=ca.crt
# ELASTICSEARCH_URL=https://localhost:9200

# Only add JVM flags for a diagnosed platform issue; otherwise leave empty.
ES_JAVA_OPTS=
